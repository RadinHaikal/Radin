<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Scenario 8 Taxi fare"/>
        <attribute name="authors" value="User"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-13 09:18:24 AM"/>
        <attribute name="created" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0xMzswOToxMzowOCBBTTsyNzQy"/>
        <attribute name="edited" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0xMzswOToxODoyNCBBTTsxOzI4NTM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="distance" type="Real" array="False" size=""/>
            <declare name="fare" type="Real" array="False" size=""/>
            <declare name="afterMidnight" type="String" array="False" size=""/>
            <input variable="distance"/>
            <input variable="afterMidnight"/>
            <if expression="distance &gt; 2">
                <then>
                    <assign variable="fare" expression="4 + (distance-2) *1.20"/>
                </then>
                <else>
                    <assign variable="fare" expression="4"/>
                </else>
            </if>
            <if expression="afterMidnight == &quot;yes&quot;">
                <then>
                    <assign variable="fare" expression="fare + 3"/>
                </then>
                <else/>
            </if>
            <output expression="fare" newline="True"/>
        </body>
    </function>
</flowgorithm>
