<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Scenario 9 Cheaper Plan"/>
        <attribute name="authors" value="User"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-13 09:30:30 AM"/>
        <attribute name="created" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0xMzswOToyNTozMyBBTTsyNzQz"/>
        <attribute name="edited" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0xMzswOTozMDozMCBBTTsxOzI4NDQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="gb" type="Real" array="False" size=""/>
            <declare name="planA" type="Real" array="False" size=""/>
            <declare name="planB" type="Real" array="False" size=""/>
            <declare name="bill" type="Real" array="False" size=""/>
            <input variable="gb"/>
            <assign variable="planA" expression="10+gb"/>
            <if expression="gb &gt; 20">
                <then>
                    <assign variable="planB" expression="25 + (gb-20) * 3"/>
                </then>
                <else>
                    <assign variable="planB" expression="25"/>
                </else>
            </if>
            <if expression="planA &lt; planB">
                <then>
                    <assign variable="bill" expression="planA"/>
                </then>
                <else>
                    <assign variable="bill" expression="planB"/>
                </else>
            </if>
            <output expression="bill" newline="True"/>
        </body>
    </function>
</flowgorithm>
