<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Scenario 6 Concert Ticket"/>
        <attribute name="authors" value="User"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-13 09:03:33 AM"/>
        <attribute name="created" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0xMzswODo1Mjo1NiBBTTsyNzQ3"/>
        <attribute name="edited" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0xMzswOTowMzozMyBBTTsyOzI4NDg="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="minutesBefore" type="Integer" array="False" size=""/>
            <declare name="membership" type="String" array="False" size=""/>
            <declare name="price" type="Real" array="False" size=""/>
            <input variable="minutesBefore"/>
            <input variable="membership"/>
            <if expression="minutesBefore &lt; 0">
                <then>
                    <assign variable="price" expression="0"/>
                </then>
                <else>
                    <if expression="minutesBefore &gt; 30">
                        <then>
                            <assign variable="price" expression="65"/>
                        </then>
                        <else>
                            <assign variable="price" expression="80"/>
                        </else>
                    </if>
                </else>
            </if>
            <if expression="membership == &quot;yes&quot;">
                <then>
                    <assign variable="price" expression="price*0.85"/>
                </then>
                <else/>
            </if>
            <output expression="price" newline="True"/>
        </body>
    </function>
</flowgorithm>
